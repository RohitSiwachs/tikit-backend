# ──────────────────────────────────────────────
# TiKit Backend — Environment Configuration
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000

# PostgreSQL (with PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD="DB_PASSWORD_HERE"
DB_DATABASE="DB_DATABASE_NAME"

# JWT (RS256)
JWT_ACCESS_EXPIRATION="YOUR JWT_ACCESS_EXPIRATION TOKEN HERE"
JWT_REFRESH_EXPIRATION="YOUR JWT_REFRESH_EXPIRATION TOKEN HERE"
JWT_PRIVATE_KEY="YOUR JWT_PRIVATE_KEY TOKEN HERE"
JWT_PUBLIC_KEY="YOUR JWT_PUBLIC_KEY TOKEN HERE"

# Bcrypt
BCRYPT_ROUNDS="YOUR BCRYPT_ROUNDS TOKEN HERE"

# Resend (Email)
RESEND_API_KEY="YOUR RESEND_API_KEY TOKEN HERE"

# SMS Provider (mock | hellosms) — use mock until HelloSMS credentials are available
SMS_PROVIDER=mock



# Expo Push Notifications
EXPO_ACCESS_TOKEN="YOUR EXPO_ACCESS_TOKEN TOKEN HERE"

REDIS_URL="YOUR REDIS_URL TOKEN HERE"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="YOUR DATABASE_URL TOKEN HERE"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="YOUR DIRECT_URL TOKEN HERE"

R2_ACCOUNT_ID="YOUR R2_ACCOUNT_ID TOKEN HERE"
R2_ACCESS_KEY_ID="YOUR R2_ACCESS_KEY_ID TOKEN HERE"
R2_SECRET_ACCESS_KEY="YOUR R2_SECRET_ACCESS_KEY TOKEN HERE"
R2_BUCKET_NAME="YOUR R2_BUCKET_NAME TOKEN HERE"
R2_PUBLIC_URL="YOUR R2_PUBLIC_URL TOKEN HERE"
R2_ENDPOINT="YOUR R2_ENDPOINT TOKEN HERE"
          
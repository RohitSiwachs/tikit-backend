# ──────────────────────────────────────────────────────────────
# TiKit Backend — Environment Configuration
# Copy this file to .env and fill in real values.
# All keys here match env.validation.ts exactly.
# ──────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL connection strings) ───────────────────
# DATABASE_URL  — used by Prisma at runtime (can be a pooled URL, e.g. PgBouncer)
# DIRECT_URL    — used by Prisma migrations (must be a direct non-pooled connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tikit_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tikit_dev"

# ── JWT (RS256 asymmetric keys) ────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the full PEM content on one line using \n for newlines.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=30

# ── CORS / Frontend ────────────────────────────────────────────
# Required in production. Multiple origins: comma-separated.
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ── AWS S3 (optional — file uploads) ──────────────────────────
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tikit-uploads

# ── SMS — 46elks (optional — falls back to console in dev) ────
ELKS_USERNAME=
ELKS_PASSWORD=

# ── Email — Resend (optional — falls back to console in dev) ──
RESEND_API_KEY=

# ── Redis Cloud (required — BullMQ queue backend) ─────────────
# Format: redis://:<password>@<host>:<port>  (TLS: rediss://...)
REDIS_URL=redis://localhost:6379

# ── Expo Push Notifications (optional — improves rate limits) ──
EXPO_ACCESS_TOKEN=

# ── Logging ────────────────────────────────────────────────────
# Overrides the default log level (debug in dev, warn in prod).
# Valid values: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

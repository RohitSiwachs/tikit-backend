#!/bin/sh
# Malware Tripwire Guard — pre-push hook
# Runs automatically before every `git push`.
# To bypass in an emergency: git push --no-verify

echo ""
echo "Running malware-guard before push..."
node scripts/malware-guard.mjs
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "Push BLOCKED by malware-guard. Fix the findings above, or use --no-verify to skip."
  exit 1
fi

exit 0
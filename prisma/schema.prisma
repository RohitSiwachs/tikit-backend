generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id                         String    @id @default(uuid())
  name                       String
  slug                       String    @unique
  city                       String
  description                String?
  logoUrl                    String?
  coverUrl                   String?
  websiteUrl                 String?
  schoolCode                 String    @unique
  deepLink                   String?
  isVerified                 Boolean   @default(false)
  isActive                   Boolean   @default(true)
  contactEmail               String?
  contactPhone               String?
  address                    String?
  users                      User[]
  events                     Event[]
  connectedEvents            Event[]   @relation("EventConnectedSchools")
  cards                      Card[]
  posts                      Post[]
  classes                    Class[]
  cardLimit                  Int       @default(1)
  // ── Shared school code controls ──────────────────────────────────────────
  sharedCodeEnabled          Boolean   @default(true)
  sharedCodeExpiry           DateTime?
  sharedCodeMaxRedemptions   Int?
  sharedCodeRedemptionCount  Int       @default(0)
  sharedCodeApprovalRequired Boolean   @default(false)

  connectionRequests           EventConnectionRequest[]
  connectionStates             EventConnectionState[]
  communicationAllocation      CommunicationAllocation?
  notificationTriggerOverrides NotificationTriggerOverride[]
  inviteCodes                  SchoolInviteCode[]
  createdAt                    DateTime                      @default(now())

  @@index([isActive])
  @@index([city])
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  displayName      String
  username         String    @unique
  password         String
  phone            String?
  role             String    @default("STUDENT")
  accountStatus    String    @default("ACTIVE")
  schoolId         String?
  school           School?   @relation(fields: [schoolId], references: [id])
  className        String?
  age              Int?
  avatarUrl        String?
  isVerified       Boolean   @default(false)
  otpCode          String? // stored as bcrypt hash in production
  otpExpiresAt     DateTime?
  approvalStatus   String    @default("pending")
  cardStatus       String    @default("inactive")
  marketingConsent Boolean   @default(false)
  joinedViaCode    Boolean   @default(false)

  firstName          String?
  lastName           String?
  gender             String?
  birthdate          DateTime?
  interests          String[]
  goingOutFrequency  String?
  preferredGroupSize String?
  eventBudget        String?

  biography               String?
  achievements            String[]
  socialLinks             Json?
  isVisibleToOtherSchools Boolean  @default(false)
  isPrivateAccount        Boolean  @default(false)
  expoPushToken           String?

  notifPush           Boolean @default(false)
  notifEmail          Boolean @default(false)
  notifSms            Boolean @default(false)
  notifFriendRequests Boolean @default(true)
  notifNewPosts       Boolean @default(true)
  notifEventInvites   Boolean @default(true)
  notifTicketReceipts Boolean @default(true)

  partnerConsent Boolean @default(false)
  theme          String  @default("system")
  language       String  @default("sv")

  // Auth security
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  otpSentAt           DateTime?
  otpAttempts         Int       @default(0)

  // Soft delete
  deletedAt DateTime?

  followers User[] @relation("UserFollows")
  following User[] @relation("UserFollows")
  friends   User[] @relation("UserFriends")
  friendOf  User[] @relation("UserFriends")

  sentFollowRequests     FollowRequest[] @relation("SentFollowRequests")
  receivedFollowRequests FollowRequest[] @relation("ReceivedFollowRequests")

  tickets             Ticket[]
  posts               Post[]
  cardCodes           CardCode[]
  eventLikes          EventLike[]
  eventComments       EventComment[]
  refreshTokens       RefreshToken[]
  vouchers            Voucher[]
  postLikes           PostLike[]
  postComments        PostComment[]
  pollVotes           PollVote[]
  redeemedInviteCodes SchoolInviteCode[] @relation("RedeemedInviteCodes")
  createdAt           DateTime           @default(now())

  @@index([schoolId])
  @@index([role])
  @@index([approvalStatus])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

model Event {
  id                   String    @id @default(uuid())
  title                String
  description          String?
  coverUrl             String?
  eventType            String    @default("INTERNAL")
  schoolId             String
  school               School    @relation(fields: [schoolId], references: [id])
  venueName            String?
  venueAddress         String?
  startsAt             DateTime
  endsAt               DateTime
  ageLimit             Int?
  externalBuyUrl       String?
  externalTicketStatus String?   @default("IN_STOCK")
  status               String    @default("draft")
  isPinned             Boolean   @default(false)
  isPublished          Boolean   @default(false)
  isCancelled          Boolean   @default(false)
  scheduledAt          DateTime?

  sortOrder               Int      @default(1)
  showImGoingButton       Boolean  @default(true)
  attendanceVisibility    String   @default("school")
  externalPriceDisplay    String?
  linkedCardIds           String[] @default([])
  restrictToCardHolders   Boolean  @default(false)
  postedBySuperAdmin    Boolean  @default(false)

  // Soft delete
  deletedAt DateTime?

  connectedSchools             School[]                      @relation("EventConnectedSchools")
  ticketTypes                  TicketType[]
  tickets                      Ticket[]
  posts                        Post[]
  likes                        EventLike[]
  comments                     EventComment[]
  connectionRequests           EventConnectionRequest[]
  connectionStates             EventConnectionState[]
  vouchers                     Voucher[]
  notificationTriggerOverrides NotificationTriggerOverride[]
  createdAt                    DateTime                      @default(now())

  @@index([schoolId])
  @@index([isPublished])
  @@index([startsAt])
  @@index([deletedAt])
  @@index([scheduledAt])
  @@index([isPublished, startsAt]) // event listing: WHERE isPublished ORDER BY startsAt
  @@index([schoolId, isPublished, startsAt]) // school-scoped listing with ORDER BY startsAt
}

model TicketType {
  id                String  @id @default(uuid())
  eventId           String
  event             Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  price             Int
  quantityTotal     Int
  quantityRemaining Int
  fewLeftThreshold  Int?    @default(10)
  isSoldOut         Boolean @default(false)
  freeForHostSchool Boolean @default(false)

  // null = host school ticket, non-null = connected school ticket
  connectionStateId String?
  connectionState   EventConnectionState? @relation(fields: [connectionStateId], references: [id], onDelete: Cascade)

  coverUrl     String?
  sortOrder    Int       @default(1)
  priceDisplay String    @default("Free")
  deepLink     String?
  tickets      Ticket[]
  vouchers     Voucher[]

  @@index([eventId])
  @@index([connectionStateId])
}

model Ticket {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  code         String     @unique
  qrToken      String     @unique
  status       String     @default("ISSUED")
  checkedInAt  DateTime?
  createdAt    DateTime   @default(now())

  // Prevent duplicate tickets per user per event
  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([userId, status]) // wallet: WHERE userId + status filter
  @@index([eventId, status]) // scanner stats: WHERE eventId + status counts
}

model Voucher {
  id           String     @id @default(uuid())
  code         String     @unique
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  createdById  String
  createdBy    User       @relation(fields: [createdById], references: [id])
  assignedToId String?
  redeemedById String?
  redeemedAt   DateTime?
  expiresAt    DateTime?
  isUsed       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([eventId])
  @@index([code])
  @@index([isUsed])
}

model Card {
  id                 String     @id @default(uuid())
  title              String
  schoolId           String
  school             School     @relation(fields: [schoolId], references: [id])
  coverUrl           String?
  description        String?
  benefits           String[]
  validFrom          DateTime
  validUntil         DateTime
  status             String     @default("draft")
  codeGenerationType String     @default("individual")
  codes              CardCode[]
  createdAt          DateTime   @default(now())

  @@index([schoolId])
  @@index([status])
}

model Post {
  id          String        @id @default(uuid())
  body        String
  imageUrl    String?
  postType    String        @default("text")
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  likes       PostLike[]
  comments    PostComment[]
  pollOptions PollOption[]
  pollVotes   PollVote[]

  // Soft delete
  pollExpiresAt DateTime?
  scheduledAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([schoolId])
  @@index([deletedAt])
  @@index([deletedAt, createdAt]) // feed: WHERE deletedAt IS NULL ORDER BY createdAt DESC
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

model CardCode {
  id         String    @id @default(uuid())
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  code       String    @unique
  isUsed     Boolean   @default(false)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  assignedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([cardId])
  @@index([userId])
  @@index([cardId, userId])
  @@index([cardId, isUsed])
}

model Class {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  className      String
  graduationYear Int
  studentCount   Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([schoolId])
}

model Segment {
  id             String   @id @default(uuid())
  name           String
  filters        Json // Changed from String to Json
  estimatedCount Int      @default(0)
  createdAt      DateTime @default(now())
}

model Campaign {
  id             String    @id @default(uuid())
  channel        String
  segmentFilters Json // Changed from String to Json
  title          String
  body           String
  sendMode       String
  scheduledAt    DateTime?
  status         String    @default("draft")
  sentCount      Int       @default(0)
  openCount      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([scheduledAt])
}

model EventConnectionRequest {
  id                 String   @id @default(uuid())
  eventId            String
  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestingSchoolId String
  requestingSchool   School   @relation(fields: [requestingSchoolId], references: [id], onDelete: Cascade)
  status             String   @default("pending")
  createdAt          DateTime @default(now())

  @@index([eventId])
}

model EventConnectionState {
  id          String    @id @default(uuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  ticketTypes TicketType[]

  @@unique([eventId, schoolId])
  @@index([eventId])
  @@index([schoolId])
}

model FollowRequest {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentFollowRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedFollowRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([receiverId])
  @@index([senderId])
}

model EventLike {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
}

model EventComment {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model PollOption {
  id        String     @id @default(uuid())
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  text      String
  votes     PollVote[]
  createdAt DateTime   @default(now())

  @@index([postId])
}

model PollVote {
  id        String     @id @default(uuid())
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([optionId])
  @@index([userId])
}

model SchoolInviteCode {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code         String    @unique
  studentName  String?
  studentEmail String?
  isUsed       Boolean   @default(false)
  usedByUserId String?
  usedBy       User?     @relation("RedeemedInviteCodes", fields: [usedByUserId], references: [id], onDelete: SetNull)
  usedAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([schoolId])
  @@index([isUsed])
}

model NotificationTriggerOverride {
  id         String   @id @default(uuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggerKey String
  title      String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolId, eventId, triggerKey])
  @@index([schoolId])
  @@index([eventId])
}

model CommunicationAllocation {
  id       String @id @default(uuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // ── Campaign / broadcast totals (implemented) ──────────────────────────
  pushAllocated  Int @default(0)
  pushUsed       Int @default(0)
  emailAllocated Int @default(0)
  emailUsed      Int @default(0)
  smsAllocated   Int @default(0)
  smsUsed        Int @default(0)

  // ── Pricing per message (for billing dashboards) ───────────────────────
  pushPrice  Decimal? @db.Decimal(10, 4)
  emailPrice Decimal? @db.Decimal(10, 4)
  smsPrice   Decimal? @db.Decimal(10, 4)

  // TODO(future): transactional tracking — add these columns when OTP / ticket
  // receipt / password-reset volumes need to be metered separately from campaigns.
  // Increment from AuthService (OTP), TicketsService (receipts), etc.
  //
  //   pushTransactionalUsed  Int @default(0)
  //   emailTransactionalUsed Int @default(0)
  //   smsTransactionalUsed   Int @default(0)
  //
  // No schema redesign needed — these sit alongside *Used fields above.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
